  "month_break_rules": {
    "definition": "月建所沖之爻為月破；月破多主失令、破散、難以成事，仍需看日辰、動變、用神旺衰是否救應。",
    "by_month_branch": {
      "子": "午",
      "丑": "未",
      "寅": "申",
      "卯": "酉",
      "辰": "戌",
      "巳": "亥",
      "午": "子",
      "未": "丑",
      "申": "寅",
      "酉": "卯",
      "戌": "辰",
      "亥": "巳"
    },
    "tags": {
      "month_break": "月破",
      "month_clash": "月沖"
    },
    "evaluation_order_hint": [
      "先定月令",
      "再判月破",
      "再看日辰、動爻、變爻能否生扶或合住"
    ]
  },
  "covert_moving_rules": {
    "name": "暗動",
    "core_rule": "靜爻逢日辰沖，若本身旺相或得月日動爻生扶，作暗動；若休囚無救，多作日破而不作暗動。",
    "required_conditions": [
      "line_is_static == true",
      "day_branch.clash == line.branch",
      "line_strength in ['旺','相','得生扶','臨月建','得日生']"
    ],
    "negative_conditions": [
      "line_is_moving == true",
      "line_is_month_break_without_rescue == true",
      "line_is_void_without_fill_or_clash_release == true",
      "line_strength in ['休','囚','死'] and no_rescue == true"
    ],
    "output_tags": [
      "暗動",
      "日沖發動"
    ],
    "note": "暗動不能只由地支沖直接判定；必須與旺衰、旬空、月破、生扶合看。"
  },
  "change_effect_rules": {
    "name": "動爻化出對本爻之回頭生剋",
    "perspective": "以動爻本爻為受作用者，變爻為作用來源。",
    "by_wuxing_relation": {
      "changed_generates_original": {
        "label": "回頭生",
        "effect": "變爻生本爻，增力"
      },
      "changed_controls_original": {
        "label": "回頭剋",
        "effect": "變爻剋本爻，減力"
      },
      "same_element": {
        "label": "化比和",
        "effect": "同氣，視旺衰而定"
      },
      "original_generates_changed": {
        "label": "化泄",
        "effect": "本爻生變爻，泄氣"
      },
      "original_controls_changed": {
        "label": "化耗/化財",
        "effect": "本爻剋變爻，耗力；若變爻為財類另依用神判斷"
      }
    },
    "algorithm": [
      "if changed_wuxing == original_wuxing => 化比和",
      "else if generates[changed_wuxing] == original_wuxing => 回頭生",
      "else if controls[changed_wuxing] == original_wuxing => 回頭剋",
      "else if generates[original_wuxing] == changed_wuxing => 化泄",
      "else if controls[original_wuxing] == changed_wuxing => 化耗/化財"
    ]
  },
  "advance_retreat_rules": {
    "name": "化進神 / 化退神",
    "default_mode": "strict_liuyao_pairs",
    "strict_liuyao_pairs": {
      "advance": {
        "寅->卯": {
          "from": "寅",
          "to": "卯",
          "element": "木"
        },
        "申->酉": {
          "from": "申",
          "to": "酉",
          "element": "金"
        },
        "丑->辰": {
          "from": "丑",
          "to": "辰",
          "element": "土"
        },
        "未->戌": {
          "from": "未",
          "to": "戌",
          "element": "土"
        }
      },
      "retreat": {
        "卯->寅": {
          "from": "卯",
          "to": "寅",
          "element": "木"
        },
        "酉->申": {
          "from": "酉",
          "to": "申",
          "element": "金"
        },
        "辰->丑": {
          "from": "辰",
          "to": "丑",
          "element": "土"
        },
        "戌->未": {
          "from": "戌",
          "to": "未",
          "element": "土"
        }
      }
    },
    "output_labels": {
      "advance": "化進",
      "retreat": "化退",
      "none": "非化進退"
    },
    "notes": [
      "嚴格六爻法只列實際納甲動變常見之進退對。",
      "火、水之同五行前後支在一般 64 卦動變對位中通常不作化進退，避免誤判。",
      "化進化退只表示本位爻增衰趨勢，不直接等同全卦吉凶。"
    ]
  },
